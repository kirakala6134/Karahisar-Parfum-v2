
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>admingiris</title>
    <link href="~/css1/Stil.css" rel="stylesheet" />
    <script src="~/js/Script.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Latest compiled and minified CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Latest compiled JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <div id="genelhak">
        <h1>Admin Giriş</h1>
    </div>
    <br />
    <div class="mesaj text-center">
        <h2 style="font-weight:300;color:red;font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif">@ViewBag.hata3</h2>
    </div>
    <form method="post">
        <div class="inputlar" style="width:50%;">
            <div class="uye" style="width:250px;">
                <img src="~/img/resimler/giris/user-head.png" alt="Alternate Text" />
            </div> 
            <label for="kadi" style="display:block">Adınız</label>
             <input style="display:block" type="text" name="adminkad" id="kadi" required placeholder="Kullanıcı adınızı giriniz">
             <label for="kparola" style="display:block">Parolanız</label>
             <input style="display:block" type="password" name="adminsifre" id="kparola" required placeholder="••••••••" minlength="4" maxlength="64">
             <input type="submit" name="btngiris" id="girdibtn" value="Giriş Yapın">
        </div>
    </form>
</body>
</html>
