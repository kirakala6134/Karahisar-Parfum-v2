
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>adminana</title>
    <link href="~/css1/Stil.css" rel="stylesheet" />
    <script src="~/js/Script.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Latest compiled and minified CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Latest compiled JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <div class="container-fluid" style="display:flex;width:100%;border:none;background-color:black">
        <div class="row" style="width: 100%; display: flex; align-items: center">
            <div class="col-md-6" style="width:80%;">
                <p style="color:black;padding:5px;border:none;margin:auto;font-size:25px;color:gold">merhaba Admin: @Session["Admin"]</p>
            </div>
            <div class="col-md-6" style="width:20%;">
                <div style="display:flex;">
                    <a href="~/Burakk/adminana" style="display: block; text-align: right; text-decoration: none; color: blue; font-size: 20px;">Ürün ekle|</a>
                    <a href="~/Burakk/Index" style="display: block; text-align: right; text-decoration: none; color: red; font-size: 20px;">Çıkış</a>
                </div>
            </div>
        </div>
    </div>
    <div id="genelhak">
        <h1>Admin Sayfası</h1>
    </div>
    <br />
    <div class="container" style="width:100%; text-align:center;">
        <table class="table table-striped table-hover" style="width: 100%; max-width: 100%; margin: 0 auto; table-layout: fixed; ">
            <tr>
                <th>işlemler</th>
                <th>urun id:</th>
                <th>urun adı:</th>
                <th>urun açıklama:</th>
                <th>urun fiyat:</th>
                <th>urun cinsiyet:</th>
                <th>urun resim:</th>
                <th>işlemler</th>
            </tr>
            @foreach (var deger in Model)
            {
                <tr>
                    <td><i class="fa-solid fa-arrows-rotate"><a href="~/Burakk/adminguncelle?id=@deger.urunid" style="text-decoration:none;font-size:15px;">Değiş</a></i></td>
                    <td>@deger.urunid</td>
                    <td>@deger.urunadi</td>
                    <td>@deger.urunkucukaciklama</td>
                    <td>@String.Format("{0:c}", deger.urunfiyat)</td>
                    <td>@deger.uruncinsiyet</td>
                    <td>@deger.urunresim</td>
                    <td><i class="fa-solid fa-trash"><a href="~/Burakk/adminsil?id=@deger.urunid" style="text-decoration:none;font-size:15px;">sil</a></i></td>
                </tr>
            }
        </table>
    </div>
</body>
</html>
