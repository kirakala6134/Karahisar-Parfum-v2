
@{
    ViewBag.Title = "Index";
    Layout = "~/sablon.cshtml";
}
<div class="container buyukresim">
    <!-- Carousel -->
    <div id="demo" class="carousel slide" data-bs-ride="carousel" style="min-width:70%;">

        <!-- Indicators/dots -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#demo" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#demo" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#demo" data-bs-slide-to="2"></button>
            <button type="button" data-bs-target="#demo" data-bs-slide-to="3"></button>
            <button type="button" data-bs-target="#demo" data-bs-slide-to="4"></button>
            <button type="button" data-bs-target="#demo" data-bs-slide-to="5"></button>
        </div>

        <!-- The slideshow/carousel -->
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/img/resimler/amaougeaanasayfa.jpg" class="d-block w-100" />
            </div>
            <div class="carousel-item">
                <img src="~/img/resimler/anasayfa2.webp" class="d-block w-100" />
            </div>
            <div class="carousel-item">
                <img src="~/img/resimler/anasayfa3.webp" class="d-block w-100" />
            </div>
            <div class="carousel-item">
                <img src="~/img/resimler/anasayfaerkek.webp" class="d-block w-100" />
            </div>
            <div class="carousel-item">
                <img src="~/img/resimler/anasayfakadın.webp" class="d-block w-100" />
            </div>
        </div>

        <!-- Left and right controls/icons -->
        <button class="carousel-control-prev" type="button" data-bs-target="#demo" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#demo" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</div>
<br />
<div style="text-align: center;width:100%">
    <b style="color: yellow; display:block; font-size: 40px; text-align:center;">Trendler</b><hr style="margin:10px 50px;">
</div>    
<div class="container">
    <div class="row">
        @foreach (var gelenid in Model)
        {
            <div class="col-12 col-md-6 col-lg-3 text-center urunliste" style="padding: 5px;">
                <a href="~/Burakk/Urunozel?gelenid=@gelenid.urunid" style="color: black; text-decoration: none">
                    <div style="border: 1px solid gray; font-size: 16px;  border-radius:10px;" class="urunkutu">
                        <div style="padding: 5px; border: 1px solid gray; margin: 5px; border-radius: 10px;">
                            <img src="~/img/@gelenid.urunresim" alt="Alternate Text" class="img-fluid" style="width:250px;" />
                        </div>
                        <p style="margin: 0px;">@gelenid.urunadi</p>
                        <p style="color:gray;opacity:0.8;margin:2px;"><i class="fa-solid fa-spray-can-sparkles"></i>@gelenid.urunmarkaadi</p>

                        <div style="margin-top:10px;">
                            <strong style="font-size:20px;">@String.Format("{0:c}", gelenid.urunfiyat)</strong>
                        </div>
                        <a href="~/Burakk/sepeteekle?id=@gelenid.urunid" class="btn btn-warning" style="width:200px;margin:5px;">sepete ekle</a>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
<br />
<div class="container" style="width:100%;">
    <div class="parfumoneri" style="display:flex;gap:10px;flex-wrap:nowrap;">
        <div class="col-6 sezonlukparfum">
            <a href="~/Burakk/Kadın"><img class="img-fluid" src="~/img/resimler/divkoy/kadın parfümlogo.jpg" /></a>
        </div>
        <div class="col-6 sezonlukparfum">
            <a href="~/Burakk/Erkek"><img class="img-fluid" src="~/img/resimler/divkoy/erkek parfümlogo.jpg" /></a>
        </div>
    </div>
</div>
<br />
<div class="container" style="margin-top:70px;">
    <div class="row">
        <div class="col-md-6">
            <img class="img-fluid parfumresim" src="~/img/resimler/divkoy/nishane fotodiv.webp" />
            <b> Nishane Meant To Be Seen Extrait de Parfum</b><br>
            <p>
                Bir parfüm düşleyin.. Sizi ilk kokladığınız andan itibaren etkisi altına alacak, büyüleyecek. <br> Geçtiğiniz yerde etkisini bırakacak ve hipnotize edici bir etki yaratacak. <br> Meant To Be Seen işte tam olarak bunun karşılığı. <br> Her mevsim elinizin altında bulunmasını isteyeceğiniz, her ortamda kullanabileceğiniz performansı ile sizi asla yarı yolda bırakmayacak nefis bir parfüm.
            </p>
            <button class="btn btn-warning" style="display:block;margin:5px auto;width:200px;">Ürüne Git</button>
        </div>
        <div class="col-md-6">
            <img class="img-fluid parfumresim" src="~/img/resimler/divkoy/clive chrisfotodiv.webp" />
            <b>
                Clive Christian Jump Up and Kiss Me Hedonistic
            </b>
            <br>
            <p>
                Jump Up and Kiss Me Hedonistic, lüks ve yoğun karakteriyle Clive Christian dünyasının<br>
                en çarpıcı parfümlerinden biri. Baştan çıkarıcı, derin ve sofistike yapısıyla <br>
                akşam kullanımı için mükemmel bir parfüm. Zarif ama iddialı havasıyla her ortamda dikkat çeker; etkileyici, kalıcı ve fark edilir bir imza bırakır. <br>Harika koku
            </p>
            <button class="btn btn-warning" style="display: block; margin: 5px auto; width:200px;">Ürüne Git</button>
        </div>
    </div>
</div>


