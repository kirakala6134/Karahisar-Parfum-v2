                        <div id="aramaSonuclariPenceresi" class="dropdown-menu shadow w-100" style="display: none; position: absolute; top: 100%; left: 0; z-index: 1000; padding: 0; max-height: 300px; overflow-y: auto;">
                        </div>
                    </li>
                </ul>
                @if (Session["kullanici"] == null)
