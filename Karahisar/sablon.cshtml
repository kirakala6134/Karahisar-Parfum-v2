                            <li><a class="dropdown-item" href="~/Burakk/Dior">Dior</a></li>
                            <li><a class="dropdown-item" href="~/Burakk/Creed">Creed</a></li>
                            <li><a class="dropdown-item" href="~/Burakk/Carolina">Carolina</a></li>
                            <li><a class="dropdown-item" href="~/Burakk/Chanel">Chanel</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/Burakk/hakkimizda">Hakkımızda</a>
                    </li>
                    <li class="aramacubuk" style="position: relative;">
                        <div class="d-flex">
                            <input class="arabeni form-control me-2"
