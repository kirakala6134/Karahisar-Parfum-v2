                    <li><a href="~/Burakk/Erkek">Erkek Parfümleri</a></li>
                    <li><a href="~/Burakk/Yeniparfumler">En Yeni Parfümler</a></li>
                </ul>
            </div>
            <div class="footer-liste">
                <h3>Kurumsal</h3>
                <ul>
                    <li><a href="~/Burakk/hakkimizda">Hakkımızda</a></li>
                    <li><a href="~/Burakk/hakkimizda">Mağazalar</a></li>
                    <li><a href="~/Burakk/iletisim">İletişim</a></li>
                    <li><a href="">Bilgi Güvenliği</a></li>
                    <li><a href="">+1 (917) 810-3415</a></li>
                </ul>
            </div>
            <div class="footer-liste">
                <h3>Markalar</h3>
                <ul>
                    <li><a href="~/Burakk/Amaouage">Amouage</a></li>
                    <li><a href="~/Burakk/Chanel">Chanel</a></li>
                    <li><a href="~/Burakk/Creed">Creed</a></li>
                    <li><a href="~/Burakk/Carolina">Carolina</a></li>
                    <li><a href="~/Burakk/Dior">Dior</a></li>
                </ul>
            </div>
            <div class="footer-liste">
                <h3>Kategoriler</h3>
                <ul>
                    <li><a href="~/Burakk/Kadın">Kadın</a></li>
                    <li><a href="~/Burakk/Erkek">Erkek</a></li>
                    <li><a href="~/Burakk/Unisex">Unisex</a></li>
                    <li><a href="">Çiçeksi/Baharatlı</a></li>
                    <li><a href="">Deri/Odunsu</a></li>
                </ul>
            </div>
        </div>
        <div class="footerqr">
            <img class="qrkod" src="~/img/resimler/items/etbis.webp" alt="QR">
            <div id="iletisim">
                <i class="fa-brands fa-instagram"></i><i class="fa-brands fa-x-twitter"></i><i class="fa-solid fa-phone"></i>
            </div>
        </div>
    </div>
    <div class="tescil">
        <p>Copyright 2025 © Karahisar Parfüm® Tüm hakları saklıdır.</p>
    </div>
    <script>
        // Küçük AI yardımları :) maksat güzel olsun
        document.getElementById('canliAramaKutusu').addEventListener('input', function () {
            let kelime = this.value;
            let pencere = document.getElementById('aramaSonuclariPenceresi');

            if (kelime.length >= 2) {
                fetch('/Burakk/CanliAramaPartial?kelime=' + encodeURIComponent(kelime))
                    .then(response => response.text())
                    .then(htmlData => {
                        if (htmlData.trim() !== '') {
                            pencere.innerHTML = htmlData;
                            pencere.style.display = 'block';
                        } else {
                            pencere.style.display = 'none';
                        }
                    })
                    .catch(err => console.error("Arama hatası:", err));
            } else {
                pencere.innerHTML = '';
                pencere.style.display = 'none';
            }
        });
        document.addEventListener('click', function (e) {
            let aramaCubugu = document.querySelector('.aramacubuk');
            let pencere = document.getElementById('aramaSonuclariPenceresi');

            if (aramaCubugu && !aramaCubugu.contains(e.target)) {
                pencere.style.display = 'none';
            }
        });
        document.getElementById('canliAramaKutusu').addEventListener('click', function () {
            let kelime = this.value;
            let pencere = document.getElementById('aramaSonuclariPenceresi');
            if (kelime.length >= 2 && pencere.innerHTML.trim() !== '') {
                pencere.style.display = 'block';
            }
        });

        let sepetKapsayici = document.querySelector('.sepet-kapsayici');
        let sepetPenceresi = document.getElementById('kucukSepetPenceresi');

        if (sepetKapsayici) {
            sepetKapsayici.addEventListener('mouseenter', function () {
                sepetPenceresi.style.display = 'block';
                fetch('/Burakk/MiniSepetPartial')
                    .then(response => response.text())
                    .then(htmlData => {
                        if (htmlData.trim() !== '') {
                            sepetPenceresi.innerHTML = htmlData;
                        } else {
                            sepetPenceresi.innerHTML = '<div class="p-3 text-center text-muted">Sepetiniz boş.</div>';
                        }
                    })
                    .catch(err => console.error("Sepet yükleme hatası:", err));
            });
            sepetKapsayici.addEventListener('mouseleave', function () {
                sepetPenceresi.style.display = 'none';
            });
        }
    </script>
</body>
</html>
